---
import { USE_CASE_LABELS, type UseCase } from '../data/use-cases';

interface Props {
  items: { use: UseCase; why: string }[];
}

const { items } = Astro.props;
---

<ul class="grid gap-x-8 gap-y-5 sm:grid-cols-2">
  {
    items.map((item) => (
      <li>
        <a
          href={`/?use=${item.use}`}
          class="border-border hover:border-accent hover:text-accent inline-block rounded-full border px-2.5 py-0.5 text-[13px] transition"
        >
          {USE_CASE_LABELS[item.use]}
        </a>
        <p class="text-muted mt-2 text-[15px] text-pretty">{item.why}</p>
      </li>
    ))
  }
</ul>
