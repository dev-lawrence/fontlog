---
import { USE_CASE_LABELS, type UseCase } from '../data/use-cases';

interface Props {
  items: { use: UseCase; why: string }[];
}

const { items } = Astro.props;
---

<ul class="border-divider divide-divider divide-y border-y">
  {
    items.map((item) => (
      <li class="grid gap-1 py-4 sm:grid-cols-[11rem_1fr] sm:gap-6">
        <p class="font-semibold">
          <a
            href={`/?use=${item.use}`}
            class="text-ink decoration-divider hover:decoration-accent underline underline-offset-4 transition-colors duration-150"
          >
            {USE_CASE_LABELS[item.use]}
          </a>
        </p>
        <p class="text-ink-2 max-w-[60ch] text-pretty">{item.why}</p>
      </li>
    ))
  }
</ul>
