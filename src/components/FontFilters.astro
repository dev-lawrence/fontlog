---
import { CLASSIFICATION_LABELS, type Classification, type Mood } from '../data/moods';
import { USE_CASE_LABELS, USE_CASE_DESCRIPTIONS, type UseCase } from '../data/use-cases';

interface Props {
  classifications: Classification[];
  moods: Mood[];
  useCases: UseCase[];
  total: number;
}

const { classifications, moods, useCases, total } = Astro.props;
---

<div class="mb-10 space-y-4" data-filters>
  <div>
    <p class="text-faint mb-2 text-xs font-medium tracking-wide uppercase">Style</p>
    <div class="flex flex-wrap items-center gap-1.5">
      {
        classifications.map((c) => (
          <button
            type="button"
            class="chip"
            data-filter="classification"
            data-value={c}
            aria-pressed="false"
          >
            {CLASSIFICATION_LABELS[c]}
          </button>
        ))
      }
      <span class="bg-border mx-1 h-4 w-px" aria-hidden="true"></span>
      {
        moods.map((m) => (
          <button type="button" class="chip" data-filter="mood" data-value={m} aria-pressed="false">
            {m}
          </button>
        ))
      }
    </div>
  </div>

  {
    useCases.length > 0 && (
      <div>
        <p class="text-faint mb-2 text-xs font-medium tracking-wide uppercase">Good for</p>
        <div class="flex flex-wrap items-center gap-1.5">
          {useCases.map((u) => (
            <button
              type="button"
              class="chip"
              data-filter="use"
              data-value={u}
              aria-pressed="false"
              title={USE_CASE_DESCRIPTIONS[u]}
            >
              {USE_CASE_LABELS[u]}
            </button>
          ))}
        </div>
      </div>
    )
  }

  <div class="text-muted flex items-center gap-3 pt-1 text-sm">
    <span data-count>{total} typefaces</span>
    <button type="button" class="hover:text-text hidden underline underline-offset-4" data-clear>
      Clear filters
    </button>
  </div>
</div>

<style>
  .chip {
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    padding: 0.25rem 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
    transition:
      color 0.15s,
      border-color 0.15s,
      background-color 0.15s;
  }
  .chip[data-filter='mood'],
  .chip[data-filter='classification'] {
    text-transform: capitalize;
  }
  .chip:hover {
    color: var(--color-text);
  }
  .chip[aria-pressed='true'] {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-contrast);
  }
</style>

<script>
  type Group = 'classification' | 'mood' | 'use';

  const root = document.querySelector<HTMLElement>('[data-filters]');
  if (root) {
    const chips = [...root.querySelectorAll<HTMLButtonElement>('.chip')];
    const countEl = root.querySelector<HTMLElement>('[data-count]');
    const clearBtn = root.querySelector<HTMLButtonElement>('[data-clear]');
    const rows = [...document.querySelectorAll<HTMLElement>('[data-font]')];

    const active: Record<Group, Set<string>> = {
      classification: new Set(),
      mood: new Set(),
      use: new Set(),
    };

    const listOf = (row: HTMLElement, key: string) =>
      (row.dataset[key] ?? '').split(' ').filter(Boolean);

    function apply() {
      let shown = 0;
      for (const row of rows) {
        const okCls =
          active.classification.size === 0 ||
          active.classification.has(row.dataset.classification ?? '');
        const moods = listOf(row, 'moods');
        const okMood = active.mood.size === 0 || [...active.mood].some((m) => moods.includes(m));
        const uses = listOf(row, 'uses');
        const okUse = active.use.size === 0 || [...active.use].some((u) => uses.includes(u));

        const visible = okCls && okMood && okUse;
        row.hidden = !visible;
        if (visible) shown++;
      }

      const anyActive = active.classification.size + active.mood.size + active.use.size > 0;
      if (countEl) {
        countEl.textContent = anyActive
          ? `${shown} of ${rows.length} typefaces`
          : `${rows.length} typefaces`;
      }
      clearBtn?.classList.toggle('hidden', !anyActive);
    }

    function toggle(chip: HTMLButtonElement, force?: boolean) {
      const group = chip.dataset.filter as Group;
      const value = chip.dataset.value!;
      const set = active[group];
      const on = force ?? !set.has(value);
      if (on) set.add(value);
      else set.delete(value);
      chip.setAttribute('aria-pressed', String(on));
    }

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        toggle(chip);
        apply();
      });
    }

    clearBtn?.addEventListener('click', () => {
      for (const set of Object.values(active)) set.clear();
      for (const chip of chips) chip.setAttribute('aria-pressed', 'false');
      apply();
      history.replaceState(null, '', location.pathname);
    });

    // Deep link: /?use=dev-tools arrives from a "Best for" tag on a font page.
    const preset = new URLSearchParams(location.search).getAll('use');
    for (const value of preset) {
      const chip = chips.find((c) => c.dataset.filter === 'use' && c.dataset.value === value);
      if (chip) toggle(chip, true);
    }
    apply();
  }
</script>
