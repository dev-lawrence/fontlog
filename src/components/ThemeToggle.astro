---
import Icon from './Icon.astro';
import { Sun03Icon, Moon02Icon } from '@hugeicons/core-free-icons';
---

<button
  id="theme-toggle"
  type="button"
  class="text-ink-2 hover:bg-raised hover:text-ink grid h-11 w-11 place-items-center rounded-lg transition-colors duration-150"
  aria-label="Switch to dark theme"
  title="Toggle light and dark theme"
>
  <Icon icon={Sun03Icon} size={20} class="hidden dark:block" />
  <Icon icon={Moon02Icon} size={20} class="block dark:hidden" />
</button>

<script>
  const btn = document.getElementById('theme-toggle');
  const root = document.documentElement;
  const sync = () =>
    btn?.setAttribute(
      'aria-label',
      root.classList.contains('dark') ? 'Switch to light theme' : 'Switch to dark theme',
    );
  sync();
  btn?.addEventListener('click', () => {
    const isDark = root.classList.toggle('dark');
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch {
      /* storage blocked */
    }
    sync();
  });
</script>
