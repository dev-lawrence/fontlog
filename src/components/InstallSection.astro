---
import CodeBlock from './CodeBlock.astro';
import type { InstallInfo } from '../lib/install';

interface Props {
  name: string;
  info: InstallInfo;
}

const { name, info } = Astro.props;
const { recipes, prompt } = info;
---

<section id="install" class="scroll-mt-24" aria-labelledby="install-title">
  <h2 id="install-title" class="text-3xl leading-tight tracking-tight">Use {name}</h2>
  <p class="lede mt-2 max-w-[60ch] text-pretty">
    Pick how your project loads fonts. For production, self-hosting avoids a third-party request.
  </p>

  <div class="mt-6" data-tabs>
    <div
      role="tablist"
      aria-label="Install method"
      class="-mx-1 flex flex-wrap gap-2 px-1 pb-4"
      data-js-only
    >
      {
        recipes.map((r, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${r.id}`}
            aria-controls={`panel-${r.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="install-tab"
          >
            {r.label}
          </button>
        ))
      }
    </div>

    {
      recipes.map((r, i) => (
        <div
          id={`panel-${r.id}`}
          data-tab={`tab-${r.id}`}
          data-panel
          data-inactive={i === 0 ? undefined : ''}
          class="install-panel space-y-3 pb-8 first:pt-0"
        >
          <h3 class="install-heading text-ink mt-4 text-xl first:mt-0">{r.label}</h3>
          {r.steps.map((s) => (
            <CodeBlock code={s.code} lang={s.lang} label={s.title} />
          ))}
          {r.note && <p class="meta max-w-[64ch] text-pretty">{r.note}</p>}
        </div>
      ))
    }
  </div>

  <details class="panel mt-2 open:pb-1">
    <summary
      class="text-ink flex min-h-12 cursor-pointer items-center px-4 py-2 font-semibold select-none"
    >
      Ask an AI coding agent to do it
    </summary>
    <div class="space-y-3 px-4 pb-4">
      <p class="meta">
        A brief with the family name, license and package details. Paste it into your agent of
        choice.
      </p>
      <CodeBlock code={prompt} lang="prompt" label="Agent prompt" />
    </div>
  </details>
</section>

<style is:global>
  .install-tab {
    min-height: 2.75rem;
    padding: 0.25rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid var(--control);
    background: var(--surface);
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color 140ms var(--ease-ui),
      border-color 140ms var(--ease-ui);
  }
  .install-tab:hover {
    background: var(--raised);
  }
  .install-tab[aria-selected='true'] {
    background: var(--accent-wash);
    border-color: var(--accent);
    box-shadow: inset 0 -3px 0 var(--accent);
    font-weight: 600;
  }
  html.js [data-tabs] .install-heading {
    display: none;
  }
  html.js [data-tabs] [data-panel][data-inactive] {
    display: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));

    // Panels only become tabpanels once the tablist is live.
    panels.forEach((p) => {
      p.setAttribute('role', 'tabpanel');
      p.setAttribute('aria-labelledby', p.dataset.tab ?? '');
    });

    const select = (tab: HTMLButtonElement, focus: boolean) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p) => {
        if (p.id === tab.getAttribute('aria-controls')) p.removeAttribute('data-inactive');
        else p.setAttribute('data-inactive', '');
      });
      if (focus) tab.focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab, false));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        let next = -1;
        if (e.key === 'ArrowRight') next = i === last ? 0 : i + 1;
        else if (e.key === 'ArrowLeft') next = i === 0 ? last : i - 1;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = last;
        if (next < 0) return;
        e.preventDefault();
        select(tabs[next], true);
      });
    });
  });
</script>
