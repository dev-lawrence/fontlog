---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { ArrowUpRight01Icon } from '@hugeicons/core-free-icons';

interface SeenOnItem {
  site: string;
  url: string;
  image?: string;
  usage?: string;
  captured: string;
}

interface Props {
  items: SeenOnItem[];
}

const { items } = Astro.props;

const globbed = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/seen-on/*.{webp,png,jpg,jpeg,avif}',
);

const resolved = await Promise.all(
  items.map(async (item) => {
    const key = item.image ? `/src/assets/seen-on/${item.image}` : null;
    const loader = key ? globbed[key] : undefined;
    const image = loader ? (await loader()).default : null;
    return { ...item, resolvedImage: image };
  }),
);

const withImage = resolved.filter((i) => i.resolvedImage);
const citations = resolved.filter((i) => !i.resolvedImage);

const cap = (s?: string) => (s ? s.charAt(0).toUpperCase() + s.slice(1) : undefined);

const monthFmt = (ym: string) => {
  const [y, m] = ym.split('-').map(Number);
  return new Date(y, m - 1).toLocaleDateString('en', { month: 'short', year: 'numeric' });
};
---

{
  withImage.length > 0 && (
    <ul class="grid gap-5 sm:grid-cols-2">
      {withImage.map((item) => (
        <li class="flex">
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group border-divider bg-surface flex w-full flex-col overflow-hidden rounded-xl border transition-[border-color,box-shadow] duration-[170ms] hover:border-[var(--card-hover-border)] hover:shadow-[var(--shadow-card)]"
          >
            <div class="bg-raised aspect-[16/10] overflow-hidden">
              <Image
                src={item.resolvedImage!}
                alt={`Screenshot of ${item.site}`}
                widths={[480, 800, 1200]}
                sizes="(min-width: 1024px) 36rem, (min-width: 640px) 45vw, 92vw"
                class="h-full w-full object-cover object-top"
              />
            </div>
            <div class="flex items-start justify-between gap-3 p-4">
              <div>
                <p class="text-ink font-semibold">
                  {item.site}
                  <span class="sr-only"> (opens in a new tab)</span>
                </p>
                <p class="meta">
                  {cap(item.usage) ?? 'In use'}
                  <span aria-hidden="true"> · </span>
                  Seen {monthFmt(item.captured)}
                </p>
              </div>
              <Icon icon={ArrowUpRight01Icon} size={20} class="arrow text-accent mt-0.5 shrink-0" />
            </div>
          </a>
        </li>
      ))}
    </ul>
  )
}
{
  citations.length > 0 && (
    <ul
      class:list={[
        'divide-divider border-divider divide-y border-y',
        withImage.length > 0 && 'mt-6',
      ]}
    >
      {citations.map((item) => (
        <li>
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex min-h-12 items-center justify-between gap-3 py-3"
          >
            <span>
              <span class="text-ink font-semibold">
                {item.site}
                <span class="sr-only"> (opens in a new tab)</span>
              </span>
              <span class="meta block sm:ml-3 sm:inline">
                {cap(item.usage) ?? 'In use'}
                <span aria-hidden="true"> · </span>
                Seen {monthFmt(item.captured)}
              </span>
            </span>
            <Icon icon={ArrowUpRight01Icon} size={20} class="arrow text-accent shrink-0" />
          </a>
        </li>
      ))}
    </ul>
  )
}
