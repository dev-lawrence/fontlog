---
import BaseLayout from '../layouts/BaseLayout.astro';
import PairPlayground from '../components/PairPlayground.tsx';
import { getFonts } from '../lib/fonts';
import { fontStack } from '../lib/stack';
import { fontLinks, playgroundStylesheet } from '../lib/gfonts';

const fonts = await getFonts();
const stacks = fonts.map((f) => fontStack(f.id, f.data));

const monoDefault = fonts.find((f) => f.data.classification === 'mono')?.id ?? fonts[0].id;
const headingDefault = fonts[0].id;
const bodyDefault =
  fonts.find((f) => f.id !== headingDefault && f.data.classification !== 'mono')?.id ?? fonts[0].id;
const defaults = { heading: headingDefault, body: bodyDefault, mono: monoDefault };

const faces = stacks
  .map((s) => s.fallbackFace)
  .filter(Boolean)
  .join('\n\n');

const headExtra =
  fontLinks(playgroundStylesheet(fonts.map((f) => f.data))) + `\n<style>\n${faces}\n</style>`;
---

<BaseLayout
  title="Pairing playground"
  description="Choose a heading, body, and code face from the catalogue. Try them together in a sample layout, then copy the install, import, CSS variables, and Tailwind v4 setup."
  headExtra={headExtra}
>
  <section class="mb-10 max-w-3xl">
    <h1 class="text-[2rem] leading-[1.08] font-semibold tracking-tight text-balance sm:text-5xl">
      Find a pairing that feels right.
    </h1>
    <p class="lede mt-4 max-w-xl text-pretty">
      Choose a heading, body, and code face. Try them together, then copy the stack.
    </p>
  </section>

  <PairPlayground client:load stacks={stacks} defaults={defaults} />
</BaseLayout>
