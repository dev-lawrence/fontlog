---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="That page doesn't exist.">
  <div class="py-16 text-center">
    <p class="text-6xl font-semibold tracking-tight">404</p>
    <p class="text-muted mt-3">That page set off into the whitespace and never came back.</p>
    <a
      href="/"
      class="border-border hover:border-accent mt-6 inline-block rounded-md border px-4 py-2 text-sm transition"
    >
      Back to the catalogue
    </a>
  </div>
</BaseLayout>
