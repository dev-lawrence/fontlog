---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TypePreview from '../../components/TypePreview.tsx';
import CodeBlock from '../../components/CodeBlock.astro';
import SeenOn from '../../components/SeenOn.astro';
import Icon from '../../components/Icon.astro';
import { ArrowUpRight01Icon, ArrowRight01Icon } from '@hugeicons/core-free-icons';
import { getFonts, resolveRefs } from '../../lib/fonts';
import { installSnippets } from '../../lib/install';
import { previewStylesheet, fontLinks } from '../../lib/gfonts';
import { PREVIEW_TEXT } from '../../consts';

export async function getStaticPaths() {
  const fonts = await getFonts();
  return fonts.map((font) => ({ params: { slug: font.id }, props: { font, fonts } }));
}

const { font, fonts } = Astro.props;
const d = font.data;
const { Content } = await render(font);

const snippets = installSnippets(d);
const pairsWith = resolveRefs(d.pairsWith, fonts);
const similarTo = resolveRefs(d.similarTo, fonts);

const preview = previewStylesheet(d);
const headExtra = preview ? fontLinks(preview) : undefined;

const fallback =
  d.classification === 'serif' ? 'serif' : d.classification === 'mono' ? 'monospace' : 'sans-serif';

const meta = [
  d.designer && `by ${d.designer}`,
  d.foundry,
  `${d.released}`,
  d.variable ? 'variable' : `${d.weights.length} weights`,
].filter(Boolean);
---

<BaseLayout
  title={d.name}
  description={`${d.name}: ${d.blurb} ${d.license}, with install snippets for npm, next/font and Google Fonts.`}
  ogImage={`/og/${font.id}.png`}
  headExtra={headExtra}
>
  <a href="/" class="text-muted hover:text-text inline-flex items-center gap-1 text-sm transition">
    <Icon icon={ArrowRight01Icon} size={15} class="rotate-180" /> All typefaces
  </a>

  <header class="border-border mt-6 border-b pb-8">
    <h1
      class="text-[15vw] leading-[0.95] sm:text-7xl"
      style={`font-family:"${d.family}", ${fallback}; font-weight:${d.featuredWeight}`}
    >
      {d.name}
    </h1>
    <p class="text-muted mt-4">{meta.join(' · ')}</p>
    <p class="mt-2 max-w-2xl text-lg text-pretty">{d.blurb}</p>
  </header>

  <!-- Preview -->
  <section class="mt-10">
    <h2 class="text-muted mb-3 text-sm font-medium tracking-wide uppercase">Preview</h2>
    <TypePreview
      client:visible
      family={d.family}
      variable={d.variable}
      weights={d.weights}
      defaultWeight={d.featuredWeight}
      defaultText={PREVIEW_TEXT}
      fallback={fallback}
    />
  </section>

  <!-- The note -->
  <section class="mt-12 grid gap-8 sm:grid-cols-[1fr_16rem]">
    <div class="prose max-w-none">
      <Content />
    </div>
    <aside class="sm:border-border space-y-5 text-sm sm:border-l sm:pl-8">
      <div>
        <h3 class="text-muted font-medium">Weights</h3>
        <p class="mt-1">{d.weights.join(' · ')}</p>
      </div>
      {
        d.axes.length > 0 && (
          <div>
            <h3 class="text-muted font-medium">Axes</h3>
            <ul class="mt-1 space-y-0.5">
              {d.axes.map((a) => (
                <li>{a}</li>
              ))}
            </ul>
          </div>
        )
      }
      <div>
        <h3 class="text-muted font-medium">License</h3>
        <p class="mt-1">
          <a
            href={d.licenseUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="decoration-border hover:decoration-accent underline underline-offset-4"
          >
            {d.license}
          </a>
        </p>
        <p class="text-muted mt-1 text-pretty">{d.licenseSummary}</p>
      </div>
      <div>
        <h3 class="text-muted font-medium">Source</h3>
        <p class="mt-1">
          <a
            href={d.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="decoration-border hover:decoration-accent inline-flex items-center gap-0.5 underline underline-offset-4"
          >
            {new URL(d.sourceUrl).hostname.replace('www.', '')}
            <Icon icon={ArrowUpRight01Icon} size={13} class="text-faint" />
          </a>
        </p>
      </div>
    </aside>
  </section>

  <!-- Install -->
  <section class="mt-14">
    <h2 class="text-xl font-semibold tracking-tight">Get it</h2>
    <p class="text-muted mt-1">
      Pick the one that fits your setup. Self-hosting is best for production; the CDN link is
      quickest to try.
    </p>
    <div class="mt-5 space-y-4">
      {snippets.map((s) => <CodeBlock code={s.code} lang={s.lang} label={s.label} note={s.note} />)}
    </div>
  </section>

  <!-- Seen on -->
  {
    d.seenOn.length > 0 && (
      <section class="mt-14">
        <h2 class="text-xl font-semibold tracking-tight">Seen on</h2>
        <p class="text-muted mt-1 mb-5">Real sites using {d.name}. Click through to see it live.</p>
        <SeenOn items={d.seenOn} />
      </section>
    )
  }

  <!-- Related -->
  {
    (pairsWith.length > 0 || similarTo.length > 0) && (
      <section class="border-border mt-14 grid gap-8 border-t pt-10 sm:grid-cols-2">
        {similarTo.length > 0 && (
          <div>
            <h2 class="text-muted text-sm font-medium tracking-wide uppercase">
              If you like this, try
            </h2>
            <ul class="mt-3 space-y-1.5">
              {similarTo.map((r) => (
                <li>
                  {r.font ? (
                    <a
                      href={`/fonts/${r.slug}`}
                      class="decoration-border hover:decoration-accent underline underline-offset-4"
                    >
                      {r.name}
                    </a>
                  ) : (
                    <span class="text-muted">{r.name}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}
        {pairsWith.length > 0 && (
          <div>
            <h2 class="text-muted text-sm font-medium tracking-wide uppercase">Pairs well with</h2>
            <ul class="mt-3 space-y-1.5">
              {pairsWith.map((r) => (
                <li>
                  {r.font ? (
                    <a
                      href={`/fonts/${r.slug}`}
                      class="decoration-border hover:decoration-accent underline underline-offset-4"
                    >
                      {r.name}
                    </a>
                  ) : (
                    <span class="text-muted">{r.name}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
    )
  }
</BaseLayout>
